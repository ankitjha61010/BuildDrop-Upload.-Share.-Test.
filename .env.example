# VidSetu Environment Configuration
#
# There is no per-user Google sign-in anywhere in this app anymore. Every visitor - uploader and
# downloader alike - shares YOUR Drive, via the server-side credentials in the section below.
# Nothing in this top section requires OAuth or a signed-in session.

# Central Server Library Folder ID (The Google Drive Folder ID of your VidSetu_Videos folder)
# Then copy the Folder ID from the Drive URL: https://drive.google.com/drive/folders/<FOLDER_ID>
# Optional - if left blank, the server looks up (or creates) a folder named VITE_DEFAULT_FOLDER_NAME.
VITE_CENTRAL_FOLDER_ID=1UHhSa7VjHL0d0C8J5Iw-mSK4xvPUEc4C

# Library Videos Folder Name
VITE_DEFAULT_FOLDER_NAME=VidSetu_Videos

# Uploads Target Folder Name
VITE_UPLOADS_FOLDER_NAME=VidSetu_Uploads

# Google API Key (lets the Watch page show the real file name/size/type with no sign-in and no
# server round-trip). Works because uploaded files are already shared as "anyone with the link
# can view" - Drive allows reading a public file's metadata with just an API key, no OAuth.
# Setup: Google Cloud Console > APIs & Services > Credentials > Create Credentials > API Key.
# Enable the Google Drive API for that project, then restrict the key (Application restrictions >
# HTTP referrers) to your site's domain so it can't be used from elsewhere - this key ships to
# the browser, unlike the credentials below.
VITE_GOOGLE_API_KEY=

# --- Server-side only: set these in the Netlify dashboard, never in VITE_-prefixed client vars ---
# Powers every server-side Drive operation: proxying downloads (/api/download-file), listing the
# library (/api/list-videos), starting an upload session and making it public
# (/api/init-upload, /api/finalize-upload), and deleting a temporary share after it's downloaded
# or once it expires (/api/consume-download). None of these need the caller to sign in - this
# refresh token IS the only credential in the whole app.
#
# Uses a refresh token for your OWN Google account rather than a service-account key - service
# account keys are blocked outright on Workspace organizations with the
# iam.disableServiceAccountKeyCreation policy enforced (a common default), so that route isn't
# available to everyone. A refresh token isn't subject to that policy, and since it acts as the
# account that already owns your Drive folders, no separate folder-sharing step is needed either.
#
# Setup:
#  1. Google Cloud Console > APIs & Services > Credentials > Create Credentials > OAuth client ID.
#     Application type: Web application. Add this Authorized redirect URI:
#       https://developers.google.com/oauthplayground
#     Copy its Client ID and Client Secret.
#  2. Go to https://developers.google.com/oauthplayground
#     - Click the gear icon (top right) > check "Use your own OAuth credentials" > paste the
#       Client ID and Client Secret from step 1.
#     - In the left panel, find "Drive API v3" and select the scope:
#         https://www.googleapis.com/auth/drive
#     - Click "Authorize APIs" and sign in with the SAME Google account that owns your
#       VidSetu_Uploads / VidSetu_Videos folders. Grant consent.
#     - Click "Exchange authorization code for tokens" - copy the Refresh token it returns.
#  3. Set all three values below (in Netlify: Site configuration > Environment variables; for
#     local `netlify dev`, in this .env file).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional: pin uploads to an exact folder ID instead of the server searching/creating one by
# VITE_UPLOADS_FOLDER_NAME.
DRIVE_UPLOADS_FOLDER_ID=
