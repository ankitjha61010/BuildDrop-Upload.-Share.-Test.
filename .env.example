# BuildDrop Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server-side only (Netlify Functions) ---
# Powers uploads, the download proxy, delete-after-download, and iOS OTA install metadata.
# From your BuildDrop project's Web application OAuth client in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token

# --- Public (baked into the frontend build) ---
# Lets anyone opening a share link fetch file metadata without signing in.
# Create at: Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API key
# Then restrict it to "Google Drive API" only.
VITE_GOOGLE_API_KEY=your-google-api-key

# Name of the Drive folder the app auto-creates for uploads (created by the app itself, so it
# always has drive.file access to it - do not point this at a manually-created folder).
VITE_UPLOADS_FOLDER_NAME=BuildDrop_Uploads
